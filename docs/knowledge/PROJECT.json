{
  "schema_version": 1,
  "id": "comfy-pet-pipeline",
  "display_name": "Comfy Pet Pipeline",
  "description": "猫狗身份保持、动作生成和透明 GIF/视频生产服务。",
  "status": "active",
  "domains": [
    "pet-generation",
    "image-to-video",
    "comfyui",
    "quality-gates",
    "content-moderation"
  ],
  "entrypoints": [
    {
      "path": "simple_pet_gif_api.py",
      "purpose": "简化 GIF API 兼容入口"
    },
    {
      "path": "local_video_api.py",
      "purpose": "本地视频 API 兼容入口"
    },
    {
      "path": "src/comfy_pet_pipeline/api/gif_api.py",
      "purpose": "简化 GIF API 主实现"
    },
    {
      "path": "src/comfy_pet_pipeline/api/local_video.py",
      "purpose": "本地视频生成主实现"
    },
    {
      "path": "src/comfy_pet_pipeline/api/platform.py",
      "purpose": "宠物生成测试平台后端"
    },
    {
      "path": "src/comfy_pet_pipeline/api/content_moderation.py",
      "purpose": "Comfy 输入门禁、独立服务适配、异步结果审核与交付撤销"
    }
  ],
  "verification": [
    "bash ops/scripts/verify-change.sh",
    ".venv/bin/python ops/scripts/run-live-stability-gallery.py --suite smoke"
  ],
  "verification_policy": {
    "required_after_every_repository_modification": true,
    "mandatory_live_smoke_matrix": {
      "cat": [
        "eating",
        "grooming"
      ],
      "dog": [
        "eating",
        "standing"
      ]
    },
    "one_job_per_species": true,
    "one_execution_per_action": true,
    "attempt_both_species_if_one_fails": true,
    "explicit_cases_are_supplementary": true
  },
  "source_docs": [
    "README.md",
    "docs/api/SIMPLE_PET_GIF_API.md",
    "docs/api/LOCAL_VIDEO_API.md",
    "docs/architecture/PET_TWO_ACTION_PIPELINE.md",
    "docs/operations/PROJECT_LAYOUT.md",
    "docs/operations/SERVER_DEPLOYMENT.md",
    "docs/operations/REGRESSION_GALLERY.md",
    "docs/api/CONTENT_MODERATION.md",
    "LICENSE",
    "COPYRIGHT.md"
  ],
  "watch_rules": [
    {
      "paths": [
        "src/comfy_pet_pipeline/api/**",
        "simple_pet_gif_api.py",
        "local_video_api.py",
        "docs/api/**"
      ],
      "knowledge": [
        "api",
        "service",
        "interface"
      ]
    },
    {
      "paths": [
        "src/comfy_pet_pipeline/pipeline/**",
        "src/comfy_pet_pipeline/identity/**",
        "src/comfy_pet_pipeline/quality/**",
        "src/comfy_pet_pipeline/media/**",
        "profiles/**"
      ],
      "knowledge": [
        "pipeline",
        "identity",
        "quality",
        "asset"
      ]
    },
    {
      "paths": [
        "ops/**",
        "docs/operations/**"
      ],
      "knowledge": [
        "deployment",
        "operations"
      ]
    },
    {
      "paths": [
        "pyproject.toml",
        "requirements.txt",
        "requirements/**"
      ],
      "knowledge": [
        "dependency",
        "verification"
      ]
    },
    {
      "paths": [
        "tests/regression/**",
        "src/comfy_pet_pipeline/regression/**",
        "ops/scripts/verify-change.sh",
        "ops/scripts/run-*-gallery.py",
        ".githooks/**",
        "AGENTS.md"
      ],
      "knowledge": [
        "verification",
        "regression",
        "operations"
      ]
    },
    {
      "paths": [
        "web/platform/**",
        "tests/integration/test_content_moderation.py"
      ],
      "knowledge": [
        "content-moderation",
        "interface",
        "verification"
      ]
    },
    {
      "paths": [
        "LICENSE",
        "COPYRIGHT.md"
      ],
      "knowledge": [
        "licensing",
        "distribution"
      ]
    }
  ],
  "excluded_content": [
    ".env values",
    "raw uploads",
    "generated media",
    "model weights",
    "/data contents",
    "production logs"
  ]
}
