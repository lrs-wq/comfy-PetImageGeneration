[Unit]
Description=Pet dress-up and media pipeline API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/comfy-pet-pipeline/apps/dressup
EnvironmentFile=/etc/comfy-pet-pipeline/common.env
ExecStart=/root/comfy-pet-pipeline/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8766 --proxy-headers
Restart=on-failure
RestartSec=5
UMask=0027

[Install]
WantedBy=multi-user.target
